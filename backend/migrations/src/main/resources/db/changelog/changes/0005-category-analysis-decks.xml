<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
		xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
		xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
		xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                            https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.27.xsd">

	<changeSet id="0005-category-analysis-decks" author="agent">
		<preConditions onFail="MARK_RAN">
			<tableExists tableName="category_analyses"/>
			<not>
				<columnExists tableName="category_analyses" columnName="slides_url"/>
			</not>
		</preConditions>
		<addColumn tableName="category_analyses">
			<column name="slides_url" type="TEXT"/>
			<column name="template_kind" type="TEXT"/>
		</addColumn>
	</changeSet>

</databaseChangeLog>
