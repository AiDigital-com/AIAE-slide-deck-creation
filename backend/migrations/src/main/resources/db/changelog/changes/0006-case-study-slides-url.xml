<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
		xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
		xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
		xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                            https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.27.xsd">

	<changeSet id="0006-case-study-slides-url" author="agent">
		<preConditions onFail="MARK_RAN">
			<tableExists tableName="case_studies"/>
			<not>
				<columnExists tableName="case_studies" columnName="slides_url"/>
			</not>
		</preConditions>
		<addColumn tableName="case_studies">
			<column name="slides_url" type="TEXT"/>
		</addColumn>
	</changeSet>

</databaseChangeLog>
