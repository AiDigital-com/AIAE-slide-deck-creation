<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
		xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
		xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
		xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                            https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.27.xsd">

	<changeSet id="0002-case-studies-initial" author="agent">
		<preConditions onFail="MARK_RAN">
			<not>
				<tableExists tableName="case_studies"/>
			</not>
		</preConditions>
		<createTable tableName="case_studies">
			<column name="id" type="BIGINT" autoIncrement="true">
				<constraints primaryKey="true" nullable="false"/>
			</column>
			<column name="title" type="TEXT">
				<constraints nullable="false"/>
			</column>
			<column name="client_name" type="TEXT"/>
			<column name="industry" type="TEXT"/>
			<column name="challenge" type="TEXT"/>
			<column name="solution" type="TEXT"/>
			<column name="results" type="TEXT"/>
			<column name="key_metrics" type="TEXT"/>
			<column name="timeline" type="TEXT"/>
			<column name="testimonial" type="TEXT"/>
			<column name="source_file_name" type="TEXT"/>
			<column name="template_url" type="TEXT"/>
			<column name="status" type="TEXT">
				<constraints nullable="false"/>
			</column>
			<column name="created_by" type="TEXT">
				<constraints nullable="false"/>
			</column>
			<column name="created_at" type="TIMESTAMPTZ">
				<constraints nullable="false"/>
			</column>
		</createTable>

		<createIndex tableName="case_studies" indexName="idx_case_studies_created_by">
			<column name="created_by"/>
		</createIndex>
	</changeSet>

</databaseChangeLog>
