<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
		xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
		xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
		xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                            https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.27.xsd">

	<changeSet id="0007-povs-initial" author="agent">
		<preConditions onFail="MARK_RAN">
			<not>
				<tableExists tableName="povs"/>
			</not>
			<not>
				<tableExists tableName="rfp_outlines"/>
			</not>
		</preConditions>
		<createTable tableName="povs">
			<column name="id" type="BIGINT" autoIncrement="true">
				<constraints primaryKey="true" nullable="false"/>
			</column>
			<column name="title" type="TEXT">
				<constraints nullable="false"/>
			</column>
			<column name="client_name" type="TEXT"/>
			<column name="industry" type="TEXT"/>
			<column name="challenge" type="TEXT"/>
			<column name="opportunity" type="TEXT"/>
			<column name="solution" type="TEXT"/>
			<column name="outcome" type="TEXT"/>
			<column name="deck_outline" type="TEXT"/>
			<column name="supplementary_notes" type="TEXT"/>
			<column name="source_file_name" type="TEXT"/>
			<column name="doc_url" type="TEXT"/>
			<column name="status" type="TEXT">
				<constraints nullable="false"/>
			</column>
			<column name="created_by" type="TEXT">
				<constraints nullable="false"/>
			</column>
			<column name="created_at" type="TIMESTAMPTZ">
				<constraints nullable="false"/>
			</column>
		</createTable>

		<createIndex tableName="povs" indexName="idx_povs_created_by">
			<column name="created_by"/>
		</createIndex>
	</changeSet>

</databaseChangeLog>
