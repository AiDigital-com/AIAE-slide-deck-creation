		<!-- MUST NOT be test-scoped. spring-tx carries org.springframework.dao, which
		     Spring Data JPA's JpaRepositoriesRegistrar loads by name at startup. A direct
		     test-scoped declaration wins over the compile edge inherited from service and
		     domain (Maven resolves nearest-first), which drops the jar from BOOT-INF/lib
		     and makes the packaged application fail to start with
		     NoClassDefFoundError: org/springframework/dao/InvalidDataAccessApiUsageException.
		     Runtime scope keeps it on the test classpath too, so integration tests that
		     reference @Transactional still compile. -->
		<dependency>
			<groupId>org.springframework</groupId>
			<artifactId>spring-tx</artifactId>
			<scope>runtime</scope>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-test</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
