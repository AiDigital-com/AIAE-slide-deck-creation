# =============================================================================
# .env.example — copy to .env (gitignored) for local-dev, or set these in the
# Replit Secrets pane for workspace and Deployment.
#
# Anything prefixed with VITE_ is exposed to the browser by Vite. NEVER put
# secrets there.
# =============================================================================

# -- Spring profile (overridden by .replit [env] on Replit) -------------------
SPRING_PROFILES_ACTIVE=local

# -- Server -------------------------------------------------------------------
PORT=8080
APP_CONTEXT_PATH=
APP_SERVICE_NAME=strategyplanning
BACKEND_DEV_PORT=5000
VITE_API_BASE_URL=
VITE_API_CONTEXT_PATH=

# -- PostgreSQL (local-dev fallback; on Replit, PG* vars are injected) -------
POSTGRES_DB=app
POSTGRES_USER=app
POSTGRES_PASSWORD=app
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# -- Auth (Clerk SSO — the ONLY auth mode) -----------------------------------
# Replit-managed Clerk Auth injects CLERK_PUBLISHABLE_KEY + CLERK_SECRET_KEY.
# Issuer/JWKS derive from the publishable key — do not paste AUTH_ISSUER_URI
# unless you intentionally override the Replit-managed tenant.
AUTH_ALLOWED_EMAIL_DOMAIN=aidigital.com
# Comma-separated EXACT trusted browser origins for the JWT azp claim (required).
# Never a publishable key. Backend fails fast when blank (AuthStartupValidator).
AUTH_AUTHORIZED_PARTIES=http://localhost:5173,http://localhost:5000
AUTH_ISSUER_URI=
AUTH_JWKS_URI=
AUTH_AUDIENCE=
CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
CLERK_SIGN_IN_FORCE_REDIRECT_URL=/
CLERK_SIGN_UP_FORCE_REDIRECT_URL=/

# -- Auth (frontend, Vite-exposed) -------------------------------------------
VITE_CLERK_PUBLISHABLE_KEY=
VITE_CLERK_JWT_TEMPLATE=aidigital-api
VITE_CLERK_SIGN_IN_FORCE_REDIRECT_URL=/
VITE_CLERK_SIGN_UP_FORCE_REDIRECT_URL=/

# -- Usage logging (PostgresUsageLogger → usage_events table) ----------------
USAGE_LOGGING_ENABLED=true
USAGE_LOG_SERVICE_NAME=strategyplanning
USAGE_LOG_ENVIRONMENT=dev

# -- JVM (Docker backend only) -----------------------------------------------
JAVA_OPTS=

# -- External setup (informational; configured in Clerk Dashboard) -----------
# GOOGLE_CLIENT_ID and GOOGLE_CLIENT_SECRET live inside Clerk in the preferred
# flow. Do NOT inject these into the application runtime.

# -- Database pool / migrations ----------------------------------------------
DB_MAX_POOL_SIZE=50
SPRING_LIQUIBASE_ENABLED=true

# -- Uploads (source documents for AI auto-draft) ----------------------------
MULTIPART_MAX_FILE_SIZE=15MB
MULTIPART_MAX_REQUEST_SIZE=60MB

# -- OpenAI (blank key means "AI not connected" — every flow still works) -----
# SECRET. Leave blank here; set the real value in Replit Secrets or your shell.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o
OPENAI_IMAGE_MODEL=gpt-image-1
OPENAI_IMAGE_SIZE=1024x1024
OPENAI_IMAGE_QUALITY=medium
OPENAI_IMAGE_BACKGROUND=transparent

# -- Category Analysis deck --------------------------------------------------
CATEGORY_ANALYSIS_TEMPLATE_ID=164QKu8KTgpxYYGtX9lGXp-M_5IHXMm-oiGromJtfI3k

# -- Case Study deck ---------------------------------------------------------
CASE_STUDY_TEMPLATE_URL=https://docs.google.com/presentation/d/1ET3mz7ZVvbn4EDSHnpOcuCw_s5Kd3g717VPq5pnADXw/edit
CASE_STUDY_TEMPLATE_PRESENTATION_ID=1ET3mz7ZVvbn4EDSHnpOcuCw_s5Kd3g717VPq5pnADXw
CASE_STUDY_MAX_SOURCE_FILES=10

# -- RFP Outline doc ---------------------------------------------------------
# Engineering must create the Google Doc template with {{token}} placeholders
# (see RfpOutlineTemplateTokens) and set its file ID before Doc export works.
RFP_OUTLINE_TEMPLATE_URL=
RFP_OUTLINE_TEMPLATE_DOC_ID=
RFP_OUTLINE_MAX_SOURCE_FILES=10

# -- RnD Request triage ------------------------------------------------------
# Buy amounts at or above this USD threshold escalate straight to RnD.
RND_ESCALATION_THRESHOLD=100000
# Capability search sources — blank means "not connected" (triage still works).
# Both are SECRETS. Leave blank here.
SLITE_API_KEY=
ASANA_ACCESS_TOKEN=

# -- Usage logging (async sink tuning) ---------------------------------------
USAGE_LOG_EXECUTOR_CORE_POOL_SIZE=1
USAGE_LOG_EXECUTOR_MAX_POOL_SIZE=2
USAGE_LOG_EXECUTOR_QUEUE_CAPACITY=200
USAGE_LOG_MAX_ERROR_MESSAGE_LENGTH=500
USAGE_LOG_MAX_USER_AGENT_LENGTH=500

# -- Outbound HTTP pool (shared by every third-party client) -----------------
APP_EXTERNAL_HTTP_CONNECT_TIMEOUT=5s
APP_EXTERNAL_HTTP_RESPONSE_TIMEOUT=30s
APP_EXTERNAL_HTTP_CONNECTION_REQUEST_TIMEOUT=5s
APP_EXTERNAL_HTTP_MAX_TOTAL_CONNECTIONS=50
APP_EXTERNAL_HTTP_MAX_CONNECTIONS_PER_ROUTE=10

# -- CORS --------------------------------------------------------------------
APP_SECURITY_CORS_ALLOWED_ORIGINS=https://*.replit.dev,https://*.repl.co,http://localhost:5173,http://localhost:5000
APP_SECURITY_CORS_MAX_AGE_SECONDS=3600

# -- Content Security Policy --------------------------------------------------
# The Clerk frontend-API origin is appended to script-src and connect-src at
# runtime from the publishable key — do not add it by hand here.
APP_SECURITY_CSP_DEFAULT_SRC='self'
APP_SECURITY_CSP_FRAME_ANCESTORS='self' https://*.replit.dev https://*.repl.co
APP_SECURITY_CSP_SCRIPT_SRC='self' 'unsafe-inline' https://challenges.cloudflare.com
APP_SECURITY_CSP_WORKER_SRC='self' blob:
APP_SECURITY_CSP_FRAME_SRC='self' https://challenges.cloudflare.com
APP_SECURITY_CSP_STYLE_SRC='self' 'unsafe-inline' https://fonts.googleapis.com
APP_SECURITY_CSP_IMG_SRC='self' data: https:
APP_SECURITY_CSP_CONNECT_SRC='self' https:
APP_SECURITY_CSP_FONT_SRC='self' data: https://fonts.gstatic.com
